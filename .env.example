# Copy this to .env for local reference, or set these as real environment
# variables wherever you deploy. Spring Boot reads these directly from the
# OS environment (see src/main/resources/application.properties) — this repo
# has no dotenv loader, so a literal .env file here does nothing on its own.

# --- Database ---
# Defaults below match the local dev Postgres setup; override for a real
# deployment's database.
DB_URL=jdbc:postgresql://localhost:5432/scheduledawg
DB_USERNAME=scheduledawg_user
DB_PASSWORD=scheduledawg123

# Schema is managed by Flyway (src/main/resources/db/migration). Leave this
# as "validate" once deployed — it should only ever be "update" for quick
# local prototyping before a migration exists for a change.
DDL_AUTO=validate
SHOW_SQL=true

# --- Secrets (required — the app won't start without these) ---
# Anthropic API key, used for syllabus grading-schema extraction.
ANTHROPIC_API_KEY=

# 256-bit base64 secret used to sign auth JWTs. Generate a fresh one for
# production — don't reuse the local dev value. E.g.:
#   openssl rand -base64 32
JWT_SECRET=

# --- Email (optional — password reset emails just log-and-skip without it) ---
# Resend API key (https://resend.com). The sandbox sender onboarding@resend.dev
# only delivers to the email on your Resend account until you verify a
# custom domain there.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# --- Cross-origin / links ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Used to build the link inside password-reset emails — should match
# wherever the frontend is actually deployed.
FRONTEND_BASE_URL=http://localhost:3000
